---
import BaseLayout from "../layouts/BaseLayout.astro";
import SocialIcon from "../components/SocialIcon.astro";
import {
  SITE,
  SOCIAL,
  EXPERIENCE,
  EDUCATION,
  CERTIFICATIONS,
  SKILLS,
} from "../config";

const schema = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  mainEntity: {
    "@type": "Person",
    "@id": `${SITE.url}/#person`,
    name: SITE.name,
    url: SITE.url,
    email: SITE.email,
    jobTitle: "Senior Software Engineer",
    worksFor: { "@type": "Organization", name: "Microsoft" },
    alumniOf: [
      { "@type": "CollegeOrUniversity", name: "Indian Institute of Technology Bombay" },
      { "@type": "CollegeOrUniversity", name: "Panjab University" },
    ],
    knowsAbout: SKILLS,
    sameAs: SOCIAL.map((s) => s.url),
  },
};

const h2 = "text-xl font-semibold tracking-tight";
---

<BaseLayout path="/" schema={schema}>
  <section class="py-6 sm:py-10 lg:py-16 flex flex-col-reverse gap-8 sm:flex-row sm:items-center sm:justify-between lg:gap-16">
    <div>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-semibold tracking-tight">Hi, I'm Divyanshu.</h1>
      <p class="mt-5 text-lg font-medium">
        {SITE.jobLine} <span class="text-muted">&middot; {SITE.location}</span>
      </p>
      <p class="mt-3 text-lg lg:text-xl text-muted max-w-xl">{SITE.tagline}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href="/assets/resume.pdf"
          class="rounded-lg bg-ink px-5 py-2.5 text-sm font-medium text-paper no-underline hover:no-underline hover:opacity-90"
        >
          Download resume
        </a>
        <a
          href={`mailto:${SITE.email}`}
          class="rounded-lg border border-line px-5 py-2.5 text-sm font-medium text-ink no-underline hover:no-underline hover:bg-card"
        >
          Email me
        </a>
      </div>
    </div>
    <img
      src="/assets/me.jpg"
      alt="Divyanshu Grover"
      width="750"
      height="1050"
      class="h-44 w-44 sm:h-52 sm:w-52 lg:h-72 lg:w-72 shrink-0 rounded-full border border-line object-cover object-[50%_18%]"
    />
  </section>

  <div class="mt-8 grid gap-10 lg:grid-cols-3 lg:gap-12">
    <section class="lg:col-span-2" aria-labelledby="resume">
      <div class="flex items-baseline justify-between gap-4">
        <h2 id="resume" class={h2}>Resume</h2>
        <p class="text-sm text-muted">Last updated {SITE.resumeUpdated}</p>
      </div>

      <!-- Inline PDF on larger screens; phones get a plain open/download card. -->
      <!-- Height follows width (A4 portrait, 595x842), not the viewport, so browser zoom keeps the whole page in view. -->
      <object
        data="/assets/resume.pdf#toolbar=0&navpanes=0&scrollbar=0&view=FitH"
        type="application/pdf"
        class="mt-4 hidden aspect-[595/842] w-full rounded-lg border border-line bg-card md:block"
      >
        <p class="p-6 text-sm text-muted">
          Your browser can't show the PDF inline. <a href="/assets/resume.pdf">Open the resume</a> instead.
        </p>
      </object>
      <div class="mt-4 rounded-lg border border-line bg-card p-6 md:hidden">
        <p class="text-sm text-muted">The resume is a one-page PDF.</p>
        <a
          href="/assets/resume.pdf"
          class="mt-4 inline-block rounded-lg bg-ink px-5 py-2.5 text-sm font-medium text-paper no-underline hover:no-underline hover:opacity-90"
        >
          Open resume (PDF)
        </a>
      </div>
    </section>

    <aside class="space-y-8 lg:pt-9">
      <section aria-labelledby="experience">
        <h2 id="experience" class={h2}>Experience</h2>
        <ul class="mt-3 space-y-3 text-sm">
          {EXPERIENCE.map((r) => (
            <li>
              <p class="font-medium">{r.what}</p>
              <p class="text-muted">{r.when}</p>
            </li>
          ))}
        </ul>
      </section>

      <section aria-labelledby="education">
        <h2 id="education" class={h2}>Education</h2>
        <ul class="mt-3 space-y-3 text-sm">
          {EDUCATION.map((e) => (
            <li>
              <p class="font-medium">{e.what}</p>
              <p class="text-muted">{e.when}</p>
            </li>
          ))}
        </ul>
      </section>

      <section aria-labelledby="certifications">
        <h2 id="certifications" class={h2}>Certifications</h2>
        <ul class="mt-3 space-y-2 text-sm">
          {CERTIFICATIONS.map((c) => <li>{c}</li>)}
        </ul>
      </section>

      <section aria-labelledby="skills">
        <h2 id="skills" class={h2}>Skills</h2>
        <ul class="mt-3 flex flex-wrap gap-2">
          {SKILLS.map((s) => (
            <li class="rounded-md border border-line bg-card px-2.5 py-1 text-xs text-muted">{s}</li>
          ))}
        </ul>
      </section>

      <section aria-labelledby="elsewhere">
        <h2 id="elsewhere" class={h2}>Elsewhere</h2>
        <ul class="mt-3 grid grid-cols-2 gap-x-4 gap-y-3 text-sm">
          {SOCIAL.map((s) => (
            <li>
              <a href={s.url} rel="me noopener" class="inline-flex items-center gap-2.5">
                <SocialIcon name={s.icon} />
                {s.name}
              </a>
            </li>
          ))}
        </ul>
      </section>
    </aside>
  </div>
</BaseLayout>
